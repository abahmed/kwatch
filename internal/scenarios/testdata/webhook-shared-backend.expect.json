    "validatingwebhookconfiguration//mesh-default-validator",
    "mutatingwebhookconfiguration//mesh-injector",
    "validatingwebhookconfiguration//policy-cleanup",
    "validatingwebhookconfiguration//policy-exceptions"
  ]
}
