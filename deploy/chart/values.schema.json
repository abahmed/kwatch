{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "required": [
    "config"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "default": "",
      "description": "Override the base name used in templates"
    },
    "fullnameOverride": {
      "type": "string",
      "default": "",
      "description": "Override the full app name used in templates"
    },
    "rbac": {
      "type": "object",
      "description": "Cluster RBAC",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "full",
            "least-privilege"
          ],
          "default": "full",
          "description": "full grants read-only access to every resource; least-privilege grants an explicit list/watch set"
        }
      },
      "additionalProperties": false
    },
    "watch": {
      "type": "object",
      "description": "Optional watched resources",
      "properties": {
        "secrets": {
          "type": "boolean",
          "default": true,
          "description": "Watch Secrets; false removes all Secret RBAC and Secret-based checks report that they cannot verify"
        }
      },
      "additionalProperties": false
    },
    "crd": {
      "type": "object",
      "description": "Cluster-wide KwatchConfig CRD ownership",
      "properties": {
        "install": {
          "type": "boolean",
          "default": true,
          "description": "Install the shared KwatchConfig CRD with this release; skipped automatically when another release owns it"
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "description": "State store volume",
      "properties": {
        "size": {
          "type": "string",
          "default": "2Gi"
        },
        "storageClass": {
          "type": "string",
          "default": ""
        },
        "existingClaim": {
          "type": "string",
          "default": ""
        },
        "emptyDir": {
          "type": "boolean",
          "default": false
        },
        "emptyDirSizeLimit": {
          "type": "string",
          "default": "2Gi"
        },
        "pinToStorageDriverNodes": {
          "type": "boolean",
          "default": true
        },
        "storageDriverTopologyKey": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [],
      "properties": {
        "repository": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": "ghcr.io/abahmed/kwatch"
        },
        "tag": {
          "type": "string",
          "default": "",
          "description": "Overrides the image tag (defaults to .Chart.AppVersion)"
        },
        "pullPolicy": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": "IfNotPresent"
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": [],
      "properties": {
        "runAsUser": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": 1000
        },
        "runAsGroup": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": 1000
        },
        "runAsNonRoot": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": true
        },
        "readOnlyRootFilesystem": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": true
        },
        "allowPrivilegeEscalation": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "default": "RuntimeDefault"
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": [],
      "properties": {
        "fsGroup": {
          "type": [
            "string",
            "boolean",
            "number",
            "object",
            "array"
          ],
          "default": 1000
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [],
      "properties": {
        "limits": {
          "type": "object",
          "required": [],
          "properties": {
            "memory": {
              "type": [
                "string",
                "boolean",
                "number",
                "object",
                "array"
              ],
              "default": "512Mi"
            },
            "cpu": {
              "type": [
                "string",
                "boolean",
                "number",
                "object",
                "array"
              ],
              "default": "500m"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "memory": {
              "type": [
                "string",
                "number"
              ],
              "default": "128Mi"
            },
            "cpu": {
              "type": [
                "string",
                "number"
              ],
              "default": "100m"
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": [
        "string",
        "boolean",
        "number",
        "object",
        "array"
      ]
    },
    "tolerations": {
      "type": [
        "string",
        "boolean",
        "number",
        "object",
        "array"
      ]
    },
    "defaultTolerations": {
      "type": "array"
    },
    "affinity": {
      "type": [
        "string",
        "boolean",
        "number",
        "object",
        "array"
      ]
    },
    "config": {
      "type": "object",
      "description": "kwatch configuration (see deploy/config.yaml for full reference)",
      "properties": {
        "resyncSeconds": {
          "type": "integer",
          "description": "Informer resync in seconds: 0 (off) or at least 30",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 30
            }
          ]
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignorePodNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severityByOwnerKind": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "heartbeatMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "integer",
              "minimum": 0,
              "description": "Seconds between pings; 0 uses the default (300)"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "crd": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "templates": {
          "type": "object",
          "description": "Go text/template overrides per incident reason",
          "additionalProperties": {
            "type": "string"
          }
        },
        "silences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "podNamePatterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "containerNames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "containerMessages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "eventMessages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nodeReasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nodeMessages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "auditLog": {
          "type": "object",
          "description": "Audit logging configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Stream all incidents as JSON (default true)"
            },
            "output": {
              "type": "string",
              "description": "Destination: stdout or file path (default stdout)"
            }
          }
        },
        "alert": {
          "type": "object",
          "description": "Provider-specific alert configuration"
        },
        "app": {
          "type": "object",
          "properties": {
            "clusterName": {
              "type": "string"
            },
            "proxyURL": {
              "type": "string"
            },
            "disableStartupMessage": {
              "type": "boolean"
            },
            "logFormatter": {
              "type": "string",
              "enum": [
                "text",
                "json"
              ]
            },
            "insecureSkipTLSVerify": {
              "type": "boolean",
              "description": "Skip TLS verification of outbound HTTPS; only for testing"
            },
            "caBundlePath": {
              "type": "string",
              "description": "PEM CA bundle for outbound HTTP, added to the system roots"
            }
          }
        },
        "upgrader": {
          "type": "object",
          "properties": {
            "disableUpdateCheck": {
              "type": "boolean"
            }
          }
        },
        "namespaceSelector": {
          "type": "string"
        },
        "ignoreContainerNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoreContainerMessages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoreNodeReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoreNodeMessages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severityByReason": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "runbooks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "maintenance": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotation": {
              "type": "string"
            },
            "untilAnnotation": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "activeProbeMonitor": {
          "type": "object",
          "description": "Active probes of HTTP, TCP and DNS targets",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "http": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "expectedStatus": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "latencyWarningMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "latencyCriticalMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "tcp": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "address"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "dns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "host"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "host": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "autoServices": {
              "type": "boolean",
              "description": "Probe the first TCP port of every ClusterIP Service (at most 200); needs egress, see networkPolicy"
            },
            "excludeNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "autoDependencies": {
              "type": "boolean",
              "description": "Probe external endpoints named in pod environments over TCP; needs egress, see networkPolicy"
            }
          },
          "additionalProperties": false
        },
        "kubelet": {
          "type": "object",
          "description": "Direct kubelet connection for node stats and metrics",
          "properties": {
            "insecureSkipVerify": {
              "type": "boolean",
              "default": false,
              "description": "Skip kubelet serving-certificate verification; only for self-signed kubelet certificates"
            }
          },
          "additionalProperties": false
        },
        "watch": {
          "type": "object",
          "description": "Optional watched resources; prefer the top-level watch.secrets value, which also removes Secret RBAC",
          "properties": {
            "secrets": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "allowDefaults": {
          "type": "boolean",
          "default": true,
          "description": "Admit the health port and allow DNS and apiServerPorts egress"
        },
        "apiServerPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [
            443,
            6443
          ],
          "description": "TCP ports opened for the Kubernetes API server and HTTPS providers",
          "minItems": 1
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "kubeletPort": {
          "type": "integer",
          "default": 10250,
          "description": "Kubelet HTTPS port opened for direct node stats reads",
          "minimum": 1,
          "maximum": 65535
        },
        "kubeletCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Node address ranges the kubelet egress rule is limited to; empty allows any address on kubeletPort"
        },
        "extraEgressPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [],
          "description": "Extra TCP ports kwatch may reach on any address, such as SMTP 25/465/587 or a webhook on a custom port"
        },
        "allowProbeEgressAll": {
          "type": "boolean",
          "default": false,
          "description": "Allow all egress from the pod: active probe targets, autoServices, autoDependencies, a proxy or providers on unusual ports"
        },
        "dnsMetricsPort": {
          "type": "integer",
          "default": 9153,
          "minimum": 0,
          "maximum": 65535,
          "description": "Cluster DNS metrics port opened to kube-dns pods in kube-system; 0 omits the rule"
        }
      },
      "additionalProperties": false
    },
    "configSecretName": {
      "type": "string",
      "default": "",
      "description": "Existing Secret containing config.yaml; avoids storing credentials in the chart ConfigMap"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 60,
      "default": 60,
      "description": "Pod termination grace period; kwatch's shutdown budget needs at least 60 seconds"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {
        "karpenter.sh/do-not-disrupt": "true",
        "cluster-autoscaler.kubernetes.io/safe-to-evict": "false"
      },
      "description": "Annotations for the kwatch Pod; the defaults keep node autoscalers from evicting it"
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Extra labels for the kwatch Pod"
    },
    "sacAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Annotations for the kwatch ServiceAccount"
    },
    "global": {
      "type": "object",
      "description": "Helm global values, accepted so the chart works as a subchart"
    }
  },
  "additionalProperties": false
}
